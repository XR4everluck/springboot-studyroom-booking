import{d as v,R as f,c as p,F as u,e as h,a as d,b as s,g as e,w as _,h as c,n as y,L as I,I as k,S as w,p as j,i as z,_ as C}from"./index-6a096289.js";const m=o=>(j("data-v-739464ec"),o=o(),z(),o),S={class:"group-page"},b={class:"group-page__author"},B=m(()=>s("div",{class:"group-page__author-info"},[s("div",{class:"font-bold"},"游湖123456"),s("div",{class:"--van-gray-6"},"2022-10-01 12:00:00")],-1)),L={class:"group-page__content"},N=m(()=>s("div",{class:"font-bold"},"分享楼下的一家咖啡厅",-1)),V=["title","onClick"],F={class:"group-page__imgs"},P={class:"group-page__stats"},E={class:"group-page__stat"},G={class:"group-page__stat"},R=v({name:"Group"}),T=v({...R,setup(o){const t=f(new Set),x=a=>t.has(a)?t.delete(a):t.add(a);return(a,$)=>{const i=I,r=k,l=w;return d(),p("div",S,[(d(),p(u,null,h(5,n=>s("article",{class:"group-page__post",key:n},[s("div",b,[e(r,{round:"",width:"48px",height:"48px",src:"https://fastly.jsdelivr.net/npm/@vant/assets/cat.jpeg"},{error:_(()=>[c("加载失败")]),loading:_(()=>[e(i,{type:"spinner",size:"20"})]),_:1}),B]),s("div",L,[N,s("div",{class:y({"van-multi-ellipsis--l3":!t.has(n),"group-page__text":!0}),title:t.has(n)?"点击收起":"点击展开",onClick:g=>x(n)}," 噫吁嚱，危乎高哉！蜀道之难，难于上青天！蚕丛及鱼凫，开国何茫然！尔来四万八千岁，不与秦塞通人烟。西当太白有鸟道，可以横绝峨眉巅。地崩山摧壮士死，然后天梯石栈相钩连。上有六龙回日之高标，下有冲波逆折之回川。黄鹤之飞尚不得过，猿猱欲度愁攀援。青泥何盘盘，百步九折萦岩峦。扪参历井仰胁息，以手抚膺坐长叹。 问君西游何时还？畏途巉岩不可攀。但见悲鸟号古木，雄飞雌从绕林间。又闻子规啼夜月，愁空山。蜀道之难，难于上青天，使人听此凋朱颜！连峰去天不盈尺，枯松倒挂倚绝壁。飞湍瀑流争喧豗，砯崖转石万壑雷。其险也如此，嗟尔远道之人胡为乎来哉！ 剑阁峥嵘而崔嵬，一夫当关，万夫莫开。所守或匪亲，化为狼与豺。朝避猛虎，夕避长蛇；磨牙吮血，杀人如麻。锦城虽云乐，不如早还家。蜀道之难，难于上青天，侧身西望长咨嗟！ ",10,V),s("div",F,[(d(),p(u,null,h(5,g=>e(r,{key:g,width:"112px",height:"112px",radius:"8",src:"https://fastly.jsdelivr.net/npm/@vant/assets/cat.jpeg"},{error:_(()=>[c("加载失败")]),loading:_(()=>[e(i,{type:"spinner",size:"20"})]),_:2},1024)),64))]),s("div",P,[s("span",E,[e(l,{name:"good-job-o",size:"18"}),c(" 123 ")]),s("span",G,[e(l,{name:"comment-o",size:"18"}),c(" 123 ")])])])])),64))])}}});const A=C(T,[["__scopeId","data-v-739464ec"]]);export{A as default};
