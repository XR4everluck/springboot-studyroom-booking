<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yourname.studyroom</groupId>
        <artifactId>studyroom-booking</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>studyroom-web</artifactId>
    <name>上岸自习室预订系统-Web聚合模块</name>
    <packaging>pom</packaging>

    <modules>
        <module>web-admin</module>
        <module>web-app</module>
        <module>web-uni</module>
        <module>web-portal</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>


    <dependencies>

        <dependency>
            <groupId>com.yourname.studyroom</groupId>
            <artifactId>studyroom-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.yourname.studyroom</groupId>
            <artifactId>studyroom-model</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!--包含spring web相关依赖-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--包含spring test相关依赖-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <!--
      说明：子模块分工——
        web-admin：管理端应用（内嵌 studyroomAdmin Vue 构建产物 + /admin REST + JWT），端口 8080；
        web-app：用户端应用（内嵌 studyroomH5 Vue 构建产物 + /app REST + JWT），端口 8081；
        web-portal：增强管理端（Thymeleaf 服务端渲染：统一登录/运营台/报表/大屏），端口 8090，可选运行。
      三个模块均为可执行应用，spring-boot-maven-plugin 对全部子模块生效。
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>