<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/pom-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yourname.studyroom</groupId>
        <artifactId>studyroom-web</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>studyroom-web-portal</artifactId>
    <name>上岸自习室预订系统-统一门户</name>
    <description>唯一可执行应用：Thymeleaf 服务端渲染，统一登录后按角色进入管理端/用户端</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 依赖两个纯业务库，复用其 Service/Mapper/VO -->
        <dependency>
            <groupId>com.yourname.studyroom</groupId>
            <artifactId>studyroom-web-admin</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.yourname.studyroom</groupId>
            <artifactId>studyroom-web-app</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- 服务端渲染模板引擎（全站无 JavaScript，无独立前端工程） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>studyroom-web-portal-1.0-SNAPSHOT</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.yourname.studyroom.PortalApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
