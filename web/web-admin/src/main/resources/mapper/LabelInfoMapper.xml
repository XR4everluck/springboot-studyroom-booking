<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yourname.studyroom.web.admin.mapper.LabelInfoMapper">

    <select id="selectListBySeatId" resultType="com.yourname.studyroom.model.entity.LabelInfo">
        select id,
               type,
               name
        from label_info
        where is_deleted = 0
          and id in
              (select label_id
               from seat_label
               where is_deleted = 0
                 and seat_id = #{id})
    </select>
</mapper>
